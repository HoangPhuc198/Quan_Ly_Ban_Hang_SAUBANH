SECRET_KEY=replace-me

# Tên doanh nghiệp hiển thị trên UI
BUSINESS_NAME=CỬA HÀNG THỜI TRANG TRẺ EM SÁU BẢNH

# Instance mặc định: tên máy hoặc .   — chỉ thêm \TEN_INSTANCE nếu dùng named instance (vd: .\SQLEXPRESS)
DB_SERVER=DESKTOP-DPRVVV0
DB_NAME=QL_BAN_HANG_SAUBANH

# yes = Windows Auth | no = SQL login + DB_USER / DB_PASSWORD
DB_TRUSTED_CONNECTION=yes
# DB_USER=sa
# DB_PASSWORD=

DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Kết nối local / ODBC 18
DB_TRUST_SERVER_CERTIFICATE=yes
DB_ENCRYPT=no

# Giới hạn số dòng đọc từ view / procedure (mặc định 200, tối đa 2000)
DB_QUERY_MAX_ROWS=200
